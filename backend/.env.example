# ==============================================================================
# TravelMind 后端环境变量配置示例 (.env.example)
# 复制本文件为 .env 并根据需要修改配置：
#   cp .env.example .env
# ==============================================================================

# 应用基础服务配置
TRAVELMIND_ENV=development
TRAVELMIND_API_HOST=127.0.0.1
TRAVELMIND_API_PORT=8000
TRAVELMIND_CORS_ORIGINS=http://localhost:3000

# 数据提供者模式 (mock: 本地预置数据 | live: 外部高德/和风 API 真实检索)
DATA_PROVIDER_MODE=live

# 地图与天气 API 密钥 (live 模式需要)
AMAP_API_KEY=your_amap_api_key_here
QWEATHER_API_KEY=your_qweather_api_key_here
QWEATHER_HOST=

# ==============================================================================
# 数据库持久化配置
# ==============================================================================
# 模式 A (推荐: 本地/Docker PostgreSQL 16 容器):
DATABASE_URL=postgresql+psycopg://travelmind:travelmind_password@localhost:5432/travelmind_db
# 自动化测试隔离数据库 (杜绝测试脏数据混入主库):
TEST_DATABASE_URL=postgresql+psycopg://travelmind:travelmind_password@localhost:5432/travelmind_test_db

# 模式 B (备选: 本地轻量 SQLite 文件):
# DATABASE_URL=sqlite:///./travelmind.db

DATABASE_ECHO=false
# 设置为 true 启用真实 PostgreSQL/SQLAlchemy 仓储持久化（推荐开启）
USE_SQL_REPOSITORY=true
AGENT_CHECKPOINT_DB_PATH=agent_checkpoints.db

# ==============================================================================
# LLM 模型与 API 调用配置 (OpenCode Go / DeepSeek / OpenAI 兼容接口)
# ==============================================================================
# 示例 1: OpenCode Go (DeepSeek)
LLM_API_KEY=your_opencode_or_deepseek_api_key
LLM_BASE_URL=https://opencode.ai/zen/go
LLM_MODEL=deepseek-v4-flash

# 示例 2: DeepSeek 官方 API
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 示例 3: OpenAI 官方 API
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o