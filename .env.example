# ==============================================================================
# TravelMind 全局环境变量配置示例
# ==============================================================================

# 后端配置 (复制至 backend/.env)
TRAVELMIND_ENV=development
TRAVELMIND_API_HOST=127.0.0.1
TRAVELMIND_API_PORT=8000
TRAVELMIND_CORS_ORIGINS=http://localhost:3000

# 数据源模式 (mock | live)
DATA_PROVIDER_MODE=live
AMAP_API_KEY=
QWEATHER_API_KEY=
QWEATHER_HOST=

# 数据库持久化连接 (默认指向 docker-compose 中的 PostgreSQL 16)
DATABASE_URL=postgresql+psycopg://travelmind:travelmind_password@localhost:5432/travelmind_db
DATABASE_ECHO=false
USE_SQL_REPOSITORY=false
AGENT_CHECKPOINT_DB_PATH=agent_checkpoints.db

# LLM 模型调用配置
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 前端配置 (复制至 frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
